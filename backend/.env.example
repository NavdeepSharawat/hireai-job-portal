# =============================================
# AI JOB PORTAL - ENVIRONMENT VARIABLES
# =============================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB (Get from MongoDB Atlas - free tier)
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/ai-job-portal?retryWrites=true&w=majority

# JWT Secret (use a long random string - 32+ characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_make_it_very_long
JWT_EXPIRE=7d

# Frontend URL (for CORS - change in production)
CLIENT_URL=http://localhost:5173
